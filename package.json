{
  "name": "all-your-handover",
  "version": "0.1.0",
  "description": "轻量级本地部署的酒店交接班工具 — 数据自有，交接由你做主",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
