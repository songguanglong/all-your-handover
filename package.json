    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0"
  }
}